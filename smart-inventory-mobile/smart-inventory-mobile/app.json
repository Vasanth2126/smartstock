{
  "expo": {
    "name": "SmartStock",
    "slug": "smart-inventory-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f1117"
      },
      "package": "com.smartstock.inventory",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SmartStock to access your camera to scan barcodes."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "6cfa1ac9-b915-4bf8-886e-35e2c0b6f860"
      }
    }
  }
}
